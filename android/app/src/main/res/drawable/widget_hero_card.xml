<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown hero: dark card with a red wash bleeding in from the left. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="#1A212C"
        android:startColor="#3A1416" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#55E10600" />
</shape>
