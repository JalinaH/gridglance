                android:includeFontPadding="false"
                android:paddingLeft="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingBottom="2dp"
                android:text="LIVE"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/session_2_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="FRI 14"
                android:textAllCaps="true"
                android:textColor="#6B7586"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/session_2_time"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="3:00 PM"
                android:textColor="#C9D0DA"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/session_3_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_session_row_idle"
            android:gravity="center_vertical"
            android:minHeight="22dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/session_3_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_session_upcoming" />

            <TextView
                android:id="@+id/session_3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Free Practice 3"
                android:textColor="#C9D0DA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/session_3_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_live_chip"
                android:includeFontPadding="false"
                android:paddingLeft="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingBottom="2dp"
                android:text="LIVE"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/session_3_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="SAT 15"
                android:textAllCaps="true"
                android:textColor="#6B7586"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/session_3_time"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="12:30 PM"
                android:textColor="#C9D0DA"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/session_4_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_session_row_idle"
            android:gravity="center_vertical"
            android:minHeight="22dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
